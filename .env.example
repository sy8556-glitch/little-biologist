# iNaturalist Computer Vision API 개인 토큰 (predict_insect.py 참고)
# https://www.inaturalist.org 에서 발급받은 값을 넣으세요. 절대 커밋하지 마세요.
INATURALIST_JWT=

# 프록시 서버 포트 (선택, 기본 5174)
PORT=5174

# 탐험 화면 동네 생태 지도(NeighborhoodMap)용 Google Maps JS API 키
VITE_GOOGLE_MAPS_API_KEY=

# AI 말벗 챗봇(/chat)용 OpenAI API 키. 절대 커밋하지 마세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase(Postgres) 연결 문자열. server/db.js가 이 값으로 pg.Pool을 만든다. 절대 커밋하지 마세요.
DATABASE_URL=

# 프론트엔드가 백엔드(이 서버)를 호출할 주소. 프론트엔드와 백엔드를 같은 origin에 배포하면
# (예: 이 서버가 dist를 함께 서빙) 비워두면 되고, 서로 다른 도메인에 나눠 배포하면 빌드 시
# 백엔드 주소(예: https://little-biologist-api.onrender.com)를 지정한다.
VITE_API_BASE_URL=
